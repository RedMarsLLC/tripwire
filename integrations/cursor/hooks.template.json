{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "\"/absolute/path/to/tripwire\" agent-hook --provider cursor"
      }
    ],
    "sessionEnd": [
      {
        "command": "\"/absolute/path/to/tripwire\" agent-hook --provider cursor"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "\"/absolute/path/to/tripwire\" agent-hook --provider cursor"
      }
    ],
    "preToolUse": [
      {
        "command": "\"/absolute/path/to/tripwire\" agent-hook --provider cursor"
      }
    ],
    "postToolUse": [
      {
        "command": "\"/absolute/path/to/tripwire\" agent-hook --provider cursor"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "\"/absolute/path/to/tripwire\" agent-hook --provider cursor"
      }
    ],
    "stop": [
      {
        "command": "\"/absolute/path/to/tripwire\" agent-hook --provider cursor"
      }
    ]
  }
}
