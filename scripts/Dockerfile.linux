FROM swift:6.2.3-noble
RUN apt-get update && apt-get install -y --no-install-recommends libsqlite3-dev libssl-dev python3 python3-pip python3-venv libglib2.0-0t64 libgl1 libegl1 libxkbcommon0 libdbus-1-3 fonts-dejavu-core gcc-mingw-w64-x86-64 xvfb xauth libxcb-cursor0 libxcb-icccm4 libxcb-keysyms1 libxcb-shape0 libxcb-xinerama0 libxcb-randr0 libxcb-render-util0 libxcb-xfixes0 libxcb-xkb1 libxkbcommon-x11-0 && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/qt && /opt/qt/bin/pip install --no-cache-dir PySide6-Essentials==6.9.3
WORKDIR /work
